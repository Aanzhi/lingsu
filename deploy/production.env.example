# Copy to the server as .env and set secret values there. Never commit the copy.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=1.15.230.239,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://1.15.230.239
CORS_ALLOWED_ORIGINS=http://1.15.230.239
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
POSTGRES_DB=kechuang
POSTGRES_USER=kechuang
POSTGRES_PASSWORD=replace-on-server
BACKEND_BIND=127.0.0.1:8000
NGINX_BIND=80
STORAGE_BACKEND=local
FILE_SCAN_REQUIRED=1
CLAMAV_ENABLED=0
CLAMAV_HOST=
ATTACHMENT_UPLOADS_ENABLED=0
DOCUMENT_CONVERTER_ENABLED=0
PDF_EXPORT_ENABLED=0
CELERY_WORKER_ENABLED=1
CELERY_BEAT_ENABLED=0
CELERY_CONCURRENCY=1
CELERY_POOL=solo
CELERY_LOG_LEVEL=WARNING
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_MAX_REQUESTS=400
GUNICORN_MAX_REQUESTS_JITTER=40
BACKEND_IMAGE=ghcr.io/aanzhi/lingsu-backend:replace-with-github-sha
WEB_IMAGE=ghcr.io/aanzhi/lingsu-web:replace-with-github-sha
# Keep the real AI provider values only on the server.
OPENAI_API_KEY=
ARK_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
