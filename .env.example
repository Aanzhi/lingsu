# Copy this file to .env before starting Docker Compose. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=kechuang
POSTGRES_USER=kechuang
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
CELERY_ENABLED=1
CELERY_WORKER_ENABLED=1
CELERY_BEAT_ENABLED=0
CELERY_CONCURRENCY=1
CELERY_POOL=solo
CELERY_LOG_LEVEL=WARNING
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_MAX_REQUESTS=400
GUNICORN_MAX_REQUESTS_JITTER=40
OPENAI_API_KEY=
ARK_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# Fernet key for encrypting the platform AI API key; generate and store this outside the repository.
AI_CONFIG_ENCRYPTION_KEY=
# Gotenberg exposes LibreOffice conversion over HTTP for Celery export tasks.
DOCUMENT_CONVERTER_URL=http://gotenberg:3000
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE=524288000
# Files >= CHUNK_UPLOAD_THRESHOLD_BYTES use resumable chunk sessions in the browser.
CHUNK_UPLOAD_THRESHOLD_BYTES=8388608
UPLOAD_CHUNK_MIN_SIZE=1048576
UPLOAD_CHUNK_MAX_SIZE=33554432
UPLOAD_SESSION_TTL_HOURS=24
# local keeps private originals in media_data. Set s3 for AWS S3 or a MinIO-compatible endpoint.
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
FILE_SCAN_REQUIRED=1
# 小规格服务器首发关闭附件入口；FILE_SCAN_REQUIRED 保持 1，避免未扫描附件进入业务。
CLAMAV_ENABLED=0
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_IMAGE=clamav/clamav-debian:1.4
# 小规格服务器默认不启用附件、PDF 和文档转换；启用前必须提供独立安全扫描/转换能力。
ATTACHMENT_UPLOADS_ENABLED=0
DOCUMENT_CONVERTER_ENABLED=0
PDF_EXPORT_ENABLED=0
# 国内或受限网络可指向信任的镜像镜像站；默认仍使用 Docker Hub 官方镜像。
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
# 国内网络环境构建加速；需要时可替换为其他可信镜像。
APT_MIRROR=https://mirrors.aliyun.com/debian
APT_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
BACKEND_BIND=127.0.0.1:8000
NGINX_BIND=80
BACKEND_IMAGE=lingsu-backend:latest
WEB_IMAGE=lingsu-nginx:latest
CLAMAV_TIMEOUT=120
